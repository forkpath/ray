import { randomUUID } from 'node:crypto'
import { Module } from '@nestjs/common'
import { CqrsModule } from '@nestjs/cqrs'
import type { <%= className %>Repository } from '~/domain/<%= name %>/<%= name %>.repository'
import { <%= constantName %>_REPOSITORY } from '~/domain/<%= name %>/<%= name %>.repository'
import { <%= className %>UseCases } from '~/application/use-cases/<%= name %>/<%= name %>.use-cases'
import { Create<%= className %>Handler, Update<%= className %>Handler, Delete<%= className %>Handler } from '~/application/commands/<%= name %>/<%= name %>.commands'
import { Get<%= className %>Handler, List<%= className %>Handler } from '~/application/queries/<%= name %>/<%= name %>.queries'
import { Prisma<%= className %>Repository } from '~/infrastructure/repositories/<%= name %>/<%= name %>.repository'
import { <%= className %>AccessPolicy } from '~/infrastructure/repositories/<%= name %>/<%= name %>-access'
import { <%= className %>Controller } from './<%= name %>.controller'

@Module({
  imports: [CqrsModule],
  controllers: [<%= className %>Controller],
  providers: [
    { provide: <%= constantName %>_REPOSITORY, useClass: Prisma<%= className %>Repository },
    <%= className %>AccessPolicy,
    { provide: <%= className %>UseCases,
      useFactory: (repository: <%= className %>Repository, access: <%= className %>AccessPolicy) =>
        new <%= className %>UseCases(repository, access, randomUUID, () => new Date()),
      inject: [<%= constantName %>_REPOSITORY, <%= className %>AccessPolicy] },
    Create<%= className %>Handler, Update<%= className %>Handler, Delete<%= className %>Handler,
    Get<%= className %>Handler, List<%= className %>Handler
  ]
})
export class <%= className %>Module {}
