# Store the real file outside the Git checkout and chmod it to 600.
# Values below are deliberately non-runnable placeholders.
DOMAIN=ray.example.com
ACME_EMAIL=operations@example.com
REDIS_PASSWORD=secret-store-value
POSTGRES_USER=ray
POSTGRES_PASSWORD=secret-store-value
POSTGRES_DB=ray
POSTGRES_DATABASE_URL=postgresql://secret-store-value@postgres:5432/ray
MONGO_INITDB_ROOT_USERNAME=ray
MONGO_INITDB_ROOT_PASSWORD=secret-store-value
MONGO_INITDB_DATABASE=ray
RABBITMQ_DEFAULT_USER=ray
RABBITMQ_DEFAULT_PASSWORD=secret-store-value
RABBITMQ_URI=amqp://secret-store-value@rabbitmq:5672
PULSE_CORS_ORIGINS=https://ray.example.com

# Infrastructure and gateway are reviewed independently from app releases.
# Every value must contain @sha256:<64 hex>; tags such as latest are forbidden.
REDIS_IMAGE=redis@sha256:1111111111111111111111111111111111111111111111111111111111111111
POSTGRES_IMAGE=postgres@sha256:2222222222222222222222222222222222222222222222222222222222222222
MONGO_IMAGE=mongo@sha256:3333333333333333333333333333333333333333333333333333333333333333
RABBITMQ_IMAGE=rabbitmq@sha256:4444444444444444444444444444444444444444444444444444444444444444
KONG_IMAGE=kong@sha256:5555555555555555555555555555555555555555555555555555555555555555
