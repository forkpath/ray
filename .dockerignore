node_modules
.nx

# Anchor with / so patterns only match at context root, not nested paths.
# /dist → excludes root dist, then negation restores only the build outputs
#         that Dockerfiles need to COPY.
/dist
!/dist/services/engine
!/dist/services/pulse
!/dist/services/worker
!/dist/apps/web
.git
.github
.cursor
.agents
.vscode
*.md
!README.md
.env
.env.*
!.env.example
docker/*
!docker/migrator/
!docker/migrator/**
docs
coverage
tmp
*.log
*.tgz
apps/mobile
apps/desktop
e2e
