{
  "endOfLine": "lf",
  "printWidth": 120,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "semi": false,
  "htmlWhitespaceSensitivity": "strict",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "proseWrap": "preserve",
  "importOrder": [
    "<TYPES>^(react/(.*)$)|^(react$)",
    "<TYPES>^(@nestjs/(.*)$)",
    "<TYPES>^(@tanstack/(.*)$)",
    "<TYPES>",
    "",
    "^(react/(.*)$)|^(react$)",
    "^@nestjs/(.*)$",
    "^@tanstack/(.*)$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@libs/(.*)$",
    "",
    "^~/(.*)$",
    "",
    "^[../]",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy", "classProperties", "exportDefaultFrom"],
  "importOrderTypeScriptVersion": "5.0.0",
  "plugins": ["prettier-plugin-tailwindcss", "@ianvs/prettier-plugin-sort-imports"]
}
