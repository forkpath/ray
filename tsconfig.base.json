{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@libs/srv-core": ["libs/server-nest/src/index.ts"],
      "@libs/srv-shared": ["libs/srv-shared/src/index.ts"],
      "@libs/mongo-dao": ["libs/mongo-dao/src/index.ts"],
      "@libs/pg-dao": ["libs/pg-dao/src/index.ts"],
      "@libs/pg-dao/*": ["libs/pg-dao/src/*"],
      "@libs/payload": ["libs/payload/src/index.ts"],
      "@libs/ui-shared/common": ["libs/ui-web/src/compat/common.ts"],
      "@libs/ui-shared/web": ["libs/ui-web/src/index.ts"],
      "@libs/ui-shared/mobile": ["libs/ui-native/src/index.ts"],
      "@libs/ui-shared/mobile/*": ["libs/ui-native/src/*"],
      "@libs/ui-shared/*": ["libs/ui-shared/src/*"],
      "@libs/common": ["libs/common/src/index.ts"],
      "@libs/common/*": ["libs/common/src/*"],
      "@libs/analytics": ["libs/analytics/src/index.ts"],
      "@libs/analytics/*": ["libs/analytics/src/*"],
      "@libs/billing": ["libs/billing/src/index.ts"],
      "@libs/billing/mobile": ["libs/billing-native/src/index.ts"],
      "@libs/billing/server": ["libs/billing-server/src/index.ts"],
      "@libs/billing/web": ["libs/billing-server/src/index.ts"],
      "@libs/billing/*": ["libs/billing/src/*"],
      "@libs/monitoring": ["libs/monitoring/src/index.ts"],
      "@libs/monitoring/*": ["libs/monitoring/src/*"],
      "@libs/email": ["libs/email/src/index.ts"],
      "@libs/email/*": ["libs/email/src/*"],
      "@libs/i18n": ["libs/i18n/src/index.ts"],
      "@libs/auth": ["libs/auth/src/index.ts"],
      "@libs/auth/*": ["libs/auth/src/*"],
      "@libs/api-core": ["libs/api-core/src/index.ts"],
      "@libs/api-client": ["libs/api-client/src/index.ts"],
      "@libs/api-client/*": ["libs/api-client/src/*"],
      "@libs/studio": ["libs/studio/src/index.ts"],
      "@libs/studio/*": ["libs/studio/src/*"],
      "@libs/auth-contract": ["libs/auth-contract/src/index.ts"],
      "@libs/auth-web": ["libs/auth-web/src/index.ts"],
      "@libs/auth-native": ["libs/auth-native/src/index.ts"],
      "@libs/auth-server": ["libs/auth-server/src/index.ts"],
      "@libs/billing-contract": ["libs/billing-contract/src/index.ts"],
      "@libs/billing-native": ["libs/billing-native/src/index.ts"],
      "@libs/billing-config": ["libs/billing-config/src/index.ts"],
      "@libs/billing-client": ["libs/billing-client/src/index.ts"],
      "@libs/billing-server": ["libs/billing-server/src/index.ts"],
      "@libs/ui-core": ["libs/ui-core/src/index.ts"],
      "@libs/ui-web": ["libs/ui-web/src/index.ts"],
      "@libs/ui-native": ["libs/ui-native/src/index.ts"],
      "@libs/server-kernel": ["libs/server-kernel/src/index.ts"],
      "@libs/server-nest": ["libs/server-nest/src/index.ts"],
      "@libs/server-redis": ["libs/server-redis/src/index.ts"],
      "@libs/server-rabbitmq": ["libs/server-rabbitmq/src/index.ts"],
      "@libs/srv-shared/rabbitmq": ["libs/server-rabbitmq/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "build", "dist", ".expo", ".wxt"]
}
