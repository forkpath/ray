# ── Logto ──────────────────────────────────────────────
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# API resource indicator（与 bootstrap/config.ts 一致）
LOGTO_API_RESOURCE=https://api.example.com

# ── Postgres（业务库编排用的管理连接）──────────────────
IAM_PG_PASSWORD=change-me
# 管理连接：用于 CREATE DATABASE / 注册表
PG_ADMIN_URL=postgres://postgres:change-me@localhost:6432/postgres
TENANT_DB_HOST=localhost
TENANT_DB_PORT=6432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=change-me

# ── Kong（Plan 2，Admin API 内网地址）──────────────────
KONG_ADMIN_URL=http://localhost:8001
KONG_PG_PASSWORD=change-me
TENANT_DOMAIN_SUFFIX=example.com
