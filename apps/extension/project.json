{
  "name": "extension",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/extension/src",
  "projectType": "application",
  "tags": ["type:app", "runtime:web", "domain:composition"],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "cache": true,
      "dependsOn": ["build-chrome", "build-firefox"],
      "outputs": ["{projectRoot}/build", "{projectRoot}/.output"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wxt",
        "cwd": "apps/extension"
      }
    },
    "dev-firefox": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wxt -b firefox",
        "cwd": "apps/extension"
      }
    },
    "build-chrome": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", "viteBuildEnvironment", { "externalDependencies": ["wxt"] }],
      "outputs": ["{projectRoot}/build", "{projectRoot}/.output"],
      "options": {
        "command": "wxt zip",
        "cwd": "apps/extension"
      },
      "dependsOn": ["^build"]
    },
    "build-firefox": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", "viteBuildEnvironment", { "externalDependencies": ["wxt"] }],
      "outputs": ["{projectRoot}/build", "{projectRoot}/.output"],
      "options": {
        "command": "wxt zip -b firefox",
        "cwd": "apps/extension"
      },
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/extension"
      }
    }
  }
}
