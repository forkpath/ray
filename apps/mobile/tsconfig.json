{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "~/*": ["apps/mobile/src/*"],
      "@libs/auth-contract": ["libs/auth-contract/src/index.ts"],
      "@libs/auth-native": ["libs/auth-native/src/index.ts"],
      "@libs/analytics": ["libs/analytics/src/index.ts"],
      "@libs/analytics/env": ["libs/analytics/src/env.ts"],
      "@libs/analytics/mobile": ["libs/analytics/src/mobile.tsx"],
      "@libs/billing": ["libs/billing/src/index.ts"],
      "@libs/billing/mobile": ["libs/billing-native/src/index.ts"],
      "@libs/billing-contract": ["libs/billing-contract/src/index.ts"],
      "@libs/billing-config": ["libs/billing-config/src/index.ts"],
      "@libs/billing-client": ["libs/billing-client/src/index.ts"],
      "@libs/billing-native": ["libs/billing-native/src/index.ts"],
      "@libs/monitoring": ["libs/monitoring/src/index.ts"],
      "@libs/monitoring/env": ["libs/monitoring/src/env.ts"],
      "@libs/monitoring/mobile": ["libs/monitoring/src/mobile.tsx"],
      "@libs/common": ["libs/common/src/index.ts"],
      "@libs/common/hooks": ["libs/common/src/hooks/index.ts"],
      "@libs/common/utils": ["libs/common/src/utils/index.ts"],
      "@libs/i18n": ["libs/i18n/src/index.ts"],
      "@libs/email": ["libs/email/src/index.ts"],
      "@libs/pg-dao": ["libs/pg-dao/src/index.ts"],
      "@libs/ui-shared/mobile": ["libs/ui-native/src/index.ts"],
      "@libs/ui-core": ["libs/ui-core/src/index.ts"],
      "@libs/ui-native": ["libs/ui-native/src/index.ts"],
      "@libs/api-client": ["libs/api-client/src/index.ts"],
      "@libs/api-client/utils": ["libs/api-client/src/utils.ts"],
      "@libs/api-core": ["libs/api-core/src/index.ts"],
      "@libs/payload": ["libs/payload/src/index.ts"]
    }
  },
  "include": [
    "src",
    "expo-env.d.ts",
    "uniwind-types.d.ts",
    "../../libs/i18n/src/typings/**/*.d.ts",
    "../../libs/ui-native/src/typings/*.d.ts",
    ".expo/types/**/*.ts"
  ]
}
