{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "tags": ["scope:frontend", "type:app", "platform:mobile"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/mobile"
      }
    },
    "run-ios": {
      "command": "expo run:ios",
      "continuous": true,
      "options": {
        "cwd": "apps/mobile",
        "args": ["--device"]
      },
      "configurations": {
        "release": {
          "args": ["--device", "--configuration", "Release"]
        }
      }
    },
    "run-android": {
      "command": "expo run:android",
      "continuous": true,
      "options": {
        "cwd": "apps/mobile",
        "args": ["--device"]
      },
      "configurations": {
        "release": {
          "args": ["--device", "--variant", "release"]
        }
      }
    },
    "build": {
      "executor": "nx:noop",
      "cache": true,
      "dependsOn": ["export"]
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^export"],
      "inputs": ["default", "^production", "expoBuildEnvironment", { "externalDependencies": ["expo"] }],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "expo export --clear",
        "cwd": "apps/mobile"
      }
    },
    "release": {
      "executor": "@nx/expo:build",
      "cache": false,
      "options": {
        "profile": "production",
        "interactive": false
      },
      "configurations": {
        "ios": { "platform": "ios" },
        "android": { "platform": "android" }
      }
    },
    "submit": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "eas submit",
        "cwd": "apps/mobile"
      }
    }
  }
}
