{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["scope:frontend", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["vite"] },
        { "env": "VITE_PRODUCT_NAME" },
        { "env": "VITE_URL" },
        { "env": "VITE_API_BASE_URL" },
        { "env": "VITE_DEFAULT_LOCALE" },
        { "env": "VITE_THEME_MODE" },
        { "env": "VITE_THEME_COLOR" },
        { "env": "VITE_STRIPE_PUBLISHABLE_KEY" },
        { "env": "VITE_BILLING_STRIPE_PRICE_PREMIUM_LIFETIME" },
        { "env": "VITE_BILLING_STRIPE_PRICE_PREMIUM_MONTHLY" },
        { "env": "VITE_BILLING_STRIPE_PRICE_PREMIUM_YEARLY" },
        { "env": "VITE_ANALYTICS_PROVIDER" },
        { "env": "VITE_POSTHOG_KEY" },
        { "env": "VITE_POSTHOG_HOST" },
        { "env": "VITE_MONITORING_PROVIDER" },
        { "env": "VITE_SENTRY_DSN" },
        { "env": "VITE_SENTRY_ENVIRONMENT" }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/web", "{projectRoot}/.output"],
      "options": {
        "cwd": "apps/web",
        "command": "vite build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/web",
        "command": "vite"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/web",
        "command": "vite"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/web",
        "command": "vite preview"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/apps/web/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        { "externalDependencies": ["eslint"] }
      ],
      "options": {
        "cwd": "apps/web",
        "command": "eslint ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", { "externalDependencies": ["typescript"] }],
      "options": {
        "cwd": "apps/web",
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    }
  }
}
