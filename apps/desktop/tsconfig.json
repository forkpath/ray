{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "electron"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "~/*": ["apps/desktop/src/*"],
      "@libs/common": ["libs/common/src/index.ts"],
      "@libs/payload": ["libs/payload/src/index.ts"],
      "@libs/auth-client-web": ["libs/auth-client-web/src/index.ts"],
      "@libs/auth-contract": ["libs/auth-contract/src/index.ts"],
      "@libs/billing-contract": ["libs/billing-contract/src/index.ts"],
      "@libs/platform-contract": ["libs/platform-contract/src/index.ts"],
      "@libs/ui-core": ["libs/ui-core/src/index.ts"],
      "@libs/ui-core/assets": ["libs/ui-core/src/assets/index.ts"],
      "@libs/ui-web": ["libs/ui-web/src/index.ts"],
      "@libs/ui-native": ["libs/ui-native/src/index.ts"],
      "@libs/studio": ["libs/studio/src/index.ts"],
      "@libs/i18n": ["libs/i18n/src/index.ts"],
      "@libs/api-core": ["libs/api-core/src/index.ts"],
      "@libs/api-client": ["libs/api-client/src/index.ts"],
      "@libs/analytics": ["libs/analytics/src/index.ts"],
      "@libs/analytics/desktop": ["libs/analytics-web/src/desktop.tsx"],
      "@libs/analytics/extension": ["libs/analytics-web/src/extension.tsx"],
      "@libs/analytics/mobile": ["libs/analytics-native/src/index.ts"],
      "@libs/analytics/server": ["libs/analytics-server/src/index.ts"],
      "@libs/analytics/web": ["libs/analytics-web/src/index.ts"],
      "@libs/monitoring": ["libs/monitoring/src/index.ts"],
      "@libs/monitoring/desktop": ["libs/monitoring-web/src/desktop.tsx"],
      "@libs/monitoring/extension": ["libs/monitoring-web/src/extension.tsx"],
      "@libs/monitoring/mobile": ["libs/monitoring-native/src/index.ts"],
      "@libs/monitoring/server": ["libs/monitoring-server/src/index.ts"],
      "@libs/monitoring/web": ["libs/monitoring-web/src/index.ts"],
      "@libs/email": ["libs/email/src/index.ts"],
      "@libs/email/server": ["libs/email-server/src/index.ts"],
      "@libs/email-server": ["./libs/email-server/src/index.ts"],
      "@libs/analytics-web": ["./libs/analytics-web/src/index.ts"],
      "@libs/analytics-native": ["./libs/analytics-native/src/index.ts"],
      "@libs/analytics-server": ["./libs/analytics-server/src/index.ts"],
      "@libs/monitoring-web": ["./libs/monitoring-web/src/index.ts"],
      "@libs/monitoring-native": ["./libs/monitoring-native/src/index.ts"],
      "@libs/monitoring-server": ["./libs/monitoring-server/src/index.ts"],
      "@libs/analytics-web/desktop": ["libs/analytics-web/src/desktop.tsx"],
      "@libs/analytics-web/extension": ["libs/analytics-web/src/extension.tsx"],
      "@libs/analytics-web/env": ["libs/analytics-web/src/env.ts"],
      "@libs/analytics-native/env": ["libs/analytics-native/src/env.ts"],
      "@libs/analytics-server/env": ["libs/analytics-server/src/env.ts"],
      "@libs/monitoring-web/desktop": ["libs/monitoring-web/src/desktop.tsx"],
      "@libs/monitoring-web/extension": ["libs/monitoring-web/src/extension.tsx"],
      "@libs/monitoring-web/env": ["libs/monitoring-web/src/env.ts"],
      "@libs/monitoring-native/env": ["libs/monitoring-native/src/env.ts"],
      "@libs/monitoring-server/env": ["libs/monitoring-server/src/env.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.*.config.ts"],
  "exclude": ["node_modules", ".vite", ".tanstack"]
}
