{
  "name": "ray",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "bootstrap": "node scripts/development/bootstrap.mjs",
    "doctor": "node scripts/development/doctor.mjs",
    "dev": "node scripts/development/bootstrap.mjs --dev",
    "clean": "node scripts/clean.mjs",
    "clean:dry-run": "node scripts/clean.mjs --dry-run",
    "db:init": "dotenv -e .env -- nx run pg-dao:init",
    "db:seed": "dotenv -e .env -- nx run pg-dao:seed",
    "db:studio": "nx run pg-dao:studio",
    "db:format": "nx run pg-dao:format",
    "db:validate": "nx run pg-dao:validate",
    "db:generate": "nx run pg-dao:generate",
    "db:migrate": "nx run pg-dao:migrate -- --name",
    "db:deploy": "nx run pg-dao:deploy",
    "db:reset": "nx run pg-dao:reset",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "ui:add": "pnpx shadcn@latest add",
    "lint": "nx affected -t lint",
    "lint:all": "nx run-many -t lint",
    "ci:affected": "nx affected -t lint,typecheck,typecheck-tests,test,build --nxBail",
    "ci:all": "nx run-many -t lint,typecheck,typecheck-tests,test,build --all --nxBail",
    "ci:checks": "node --test scripts/ci/*.test.mjs",
    "ci:container-contracts": "bash scripts/ci/check-container-contracts.sh",
    "ci:nx-cache-contracts": "node scripts/ci/check-nx-cache-contracts.mjs",
    "ci:patches": "node scripts/ci/check-patches.mjs",
    "dev:web": "dotenv -e .env -- nx run web:dev",
    "dev:engine": "dotenv -e .env -- nx run engine:serve",
    "dev:pulse": "dotenv -e .env -- nx run pulse:serve",
    "dev:worker": "dotenv -e .env -- nx run worker:serve",
    "dev:desktop": "dotenv -e .env -- nx run desktop:dev",
    "dev:extension": "dotenv -e .env -- nx run extension:dev",
    "dev:mobile": "dotenv -e .env -- nx run mobile:start",
    "dev:mobile:ios": "dotenv -e .env -- nx run mobile:run-ios",
    "dev:mobile:android": "dotenv -e .env -- nx run mobile:run-android",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml --env-file .env up -d --wait",
    "docker:dev:up": "docker compose -f docker/docker-compose.dev.yml --env-file .env up -d --wait",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml --env-file .env down",
    "build:web": "nx run web:build",
    "build:engine": "nx run engine:build",
    "build:pulse": "nx run pulse:build",
    "build:worker": "nx run worker:build",
    "build:desktop": "nx run desktop:build",
    "build:extension:chrome": "nx run extension:build-chrome",
    "build:extension:firefox": "nx run extension:build-firefox",
    "build:mobile:ios": "dotenv -e .env -- nx run mobile:run-ios:release",
    "build:mobile:android": "dotenv -e .env -- nx run mobile:run-android:release",
    "release:mobile:ios": "nx run mobile:release:ios",
    "release:mobile:android": "nx run mobile:release:android",
    "release:desktop": "nx run desktop:release",
    "package:desktop": "nx run desktop:package",
    "verify:libs": "nx run-many -t lint,typecheck,test -p analytics,billing-contract,billing-client-native,billing-server,monitoring",
    "verify:mobile": "nx run mobile:typecheck && nx run mobile:export",
    "add:web-ui": "pnpx shadcn@latest add -p libs/ui-web/src/components",
    "add:mobile-ui": "pnpx shadcn@latest add -p libs/ui-native/src/components",
    "update": "nx migrate latest",
    "postinstall": "lefthook install",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:skills:check": "node scripts/sync-skills.mjs --check"
  },
