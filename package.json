  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:dry-run": "node scripts/clean.mjs --dry-run",
    "db:seed": "nx run pg-dao:seed",
    "db:studio": "nx run pg-dao:studio",
    "db:format": "nx run pg-dao:format",
    "db:validate": "nx run pg-dao:validate",
    "db:generate": "nx run pg-dao:generate",
    "db:migrate": "nx run pg-dao:migrate -- --name",
    "db:reset": "nx run pg-dao:reset",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "ui:add": "pnpx shadcn@latest add",
    "lint": "nx affected -t lint",
    "lint:all": "nx run-many -t lint",
    "dev:web": "dotenv -e .env.local -- nx run web:dev",
    "dev:engine": "dotenv -e .env.local -- nx run engine:serve",
    "dev:desktop": "dotenv -e .env.local -- nx run desktop:dev",
    "dev:mobile": "dotenv -e .env.local -- nx run mobile:start",
    "dev:extension": "dotenv -e .env.local -- nx run extension:dev",
    "build:web": "nx run web:build",
    "build:engine": "nx run engine:build",
    "build:desktop": "nx run desktop:build",
    "build:extension:chrome": "nx run extension:build-chrome",
    "build:extension:firefox": "nx run extension:build-firefox",
    "mobile:ios": "nx run mobile:run-ios",
    "mobile:android": "nx run mobile:run-android",
    "verify:libs": "nx run-many -t lint,typecheck,test -p analytics,billing,monitoring",
    "verify:mobile": "nx run mobile:typecheck && nx run mobile:export",
    "add:web-ui": "pnpx shadcn@latest add -p libs/ui-shared/src/web/components",
    "add:mobile-ui": "pnpx shadcn@latest add -p libs/ui-shared/src/mobile/components",
    "update": "nx migrate latest",
    "postinstall": "lefthook install",
    "sync:skills": "./scripts/sync-skills.sh"
  },
