{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "ESNext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "bundler",
    "paths": {
      "@libs/server-kernel": ["libs/server-kernel/src/index.ts"],
      "@libs/server-rabbitmq": ["libs/server-rabbitmq/src/index.ts"],
      "@libs/srv-shared": ["libs/srv-shared/src/index.ts"],
      "@libs/srv-shared/rabbitmq": ["libs/server-rabbitmq/src/index.ts"],
      "@libs/mongo-dao": ["libs/mongo-dao/src/index.ts"],
      "@libs/pg-dao": ["libs/pg-dao/src/index.ts"],
      "@libs/pg-dao/*": ["libs/pg-dao/src/*"],
      "@libs/common": ["libs/common/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
