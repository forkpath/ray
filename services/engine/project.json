{
  "name": "engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/engine/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "services/engine"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "env": "NODE_ENV" }],
      "outputs": ["{workspaceRoot}/dist/services/engine"],
      "options": {
        "command": "webpack-cli build --config-node-env production",
        "cwd": "services/engine"
      },
      "configurations": {
        "development": {
          "command": "webpack-cli build --config-node-env development"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{workspaceRoot}/scripts/create-service-lockfile.js"],
      "outputs": [
        "{workspaceRoot}/dist/services/engine/package.json",
        "{workspaceRoot}/dist/services/engine/pnpm-lock.yaml"
      ],
      "options": {
        "command": "node scripts/create-service-lockfile.js engine"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/scripts/prepare-service-workspace-modules.js"],
      "outputs": ["{workspaceRoot}/dist/services/engine/workspace_modules"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/prepare-service-workspace-modules.js engine"
      }
    },
    "package": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "prune": {
      "dependsOn": ["package"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "engine:build",
        "runBuildTargetDependencies": false,
        "watch": true
      },
      "configurations": {
        "development": {
          "buildTarget": "engine:build:development"
        },
        "production": {
          "buildTarget": "engine:build:production"
        }
      }
    }
  }
}
