{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "dev",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/workflows/ci-baseline.yml",
      { "runtime": "node --version" },
      { "runtime": "node -p \"process.platform + '-' + process.arch\"" }
    ],
    "viteBuildEnvironment": [
      { "env": "NODE_ENV" },
      { "env": "MODE" },
      { "env": "VITE_ANALYTICS_PROVIDER" },
      { "env": "VITE_API_BASE_URL" },
      { "env": "VITE_API_ENDPOINT" },
      { "env": "VITE_AUTH_ANONYMOUS" },
      { "env": "VITE_AUTH_MAGIC_LINK" },
      { "env": "VITE_AUTH_PASSKEY" },
      { "env": "VITE_AUTH_PASSWORD" },
      { "env": "VITE_BILLING_STRIPE_PRICE_PREMIUM_LIFETIME" },
      { "env": "VITE_BILLING_STRIPE_PRICE_PREMIUM_MONTHLY" },
      { "env": "VITE_BILLING_STRIPE_PRICE_PREMIUM_YEARLY" },
      { "env": "VITE_DEFAULT_LOCALE" },
      { "env": "VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID" },
      { "env": "VITE_MONITORING_PROVIDER" },
      { "env": "VITE_POSTHOG_HOST" },
      { "env": "VITE_POSTHOG_KEY" },
      { "env": "VITE_PRODUCT_NAME" },
      { "env": "VITE_SENTRY_DESKTOP_DSN" },
      { "env": "VITE_SENTRY_DSN" },
      { "env": "VITE_SENTRY_ENVIRONMENT" },
      { "env": "VITE_SENTRY_EXTENSION_DSN" },
      { "env": "VITE_STRIPE_PUBLISHABLE_KEY" },
      { "env": "VITE_THEME_COLOR" },
      { "env": "VITE_THEME_MODE" },
      { "env": "VITE_URL" }
    ],
    "expoBuildEnvironment": [
      { "env": "NODE_ENV" },
      { "env": "EXPO_PUBLIC_ANALYTICS_PROVIDER" },
      { "env": "EXPO_PUBLIC_API_BASE_URL" },
      { "env": "EXPO_PUBLIC_AUTH_ANONYMOUS" },
      { "env": "EXPO_PUBLIC_AUTH_EMAIL_OTP" },
      { "env": "EXPO_PUBLIC_AUTH_MAGIC_LINK" },
      { "env": "EXPO_PUBLIC_AUTH_PASSWORD" },
      { "env": "EXPO_PUBLIC_DEFAULT_LOCALE" },
      { "env": "EXPO_PUBLIC_EAS_PROJECT_ID" },
      { "env": "EXPO_PUBLIC_EAS_UPDATES_URL" },
      { "env": "EXPO_PUBLIC_GOOGLE_CLIENT_ID" },
      { "env": "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS" },
      { "env": "EXPO_PUBLIC_MIXPANEL_TOKEN" },
      { "env": "EXPO_PUBLIC_MONITORING_PROVIDER" },
      { "env": "EXPO_PUBLIC_POSTHOG_HOST" },
      { "env": "EXPO_PUBLIC_POSTHOG_KEY" },
      { "env": "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY" },
      { "env": "EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY" },
      { "env": "EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY" },
      { "env": "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY" },
      { "env": "EXPO_PUBLIC_REVENUECAT_PRODUCT_PREMIUM_LIFETIME" },
      { "env": "EXPO_PUBLIC_REVENUECAT_PRODUCT_PREMIUM_MONTHLY" },
      { "env": "EXPO_PUBLIC_REVENUECAT_PRODUCT_PREMIUM_YEARLY" },
      { "env": "EXPO_PUBLIC_SENTRY_DSN" },
      { "env": "EXPO_PUBLIC_SENTRY_ENVIRONMENT" },
      { "env": "EXPO_PUBLIC_SITE_URL" },
      { "env": "EXPO_PUBLIC_THEME_COLOR" },
      { "env": "EXPO_PUBLIC_THEME_MODE" }
    ]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production", { "env": "CI" }],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "env": "NODE_ENV" }]
    },
    "package": {
      "cache": false
    },
    "release": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "reset": {
      "cache": false
    },
    "push": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "studio": {
      "cache": false
    },
    "submit": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  },
  "nxCloudId": "6959ecc71681f158d43050b6",
  "plugins": [
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/expo/plugin",
      "options": {
        "startTargetName": "start",
        "runIosTargetName": "run-ios",
        "runAndroidTargetName": "run-android",
        "exportTargetName": "export",
        "prebuildTargetName": "prebuild",
        "buildTargetName": "build",
        "submitTargetName": "submit"
      }
    }
  ],
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    }
  },
  "analytics": false
}
