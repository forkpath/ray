{
  "name": "pg-dao",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/pg-dao/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "libs/pg-dao"
      }
    },
    "prisma": {
      "command": "prisma",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "format": {
      "command": "prisma format --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "seed": {
      "command": "prisma db seed --config ./prisma.config.ts",
      "options": {
        "cwd": "libs/pg-dao"
      },
      "dependsOn": [
        {
          "projects": "auth",
          "target": "seed"
        }
      ]
    },
    "studio": {
      "command": "prisma studio --config ./prisma.config.ts",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "generate": {
      "command": "prisma generate --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --schema ./src --name={args.name}",
        "cwd": "libs/pg-dao"
      }
    },
    "reset": {
      "command": "prisma migrate reset --schema ./src --force",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "deploy": {
      "command": "prisma migrate deploy --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "push": {
      "command": "prisma db push --schema ./src --accept-data-loss",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "validate": {
      "command": "prisma validate --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    }
  }
}
