enum SubscriptionStatus {
  active
  canceled
  incomplete
  incomplete_expired
  past_due
  paused
  trialing
  unpaid

  @@schema("billing")
}

enum PaymentStatus {
  pending
  succeeded
  failed

  @@schema("billing")
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
  skipped

  @@schema("billing")
}

model WebhookEvent {
  id            String             @id @default(cuid())
  eventId       String             @map("event_id")
  provider      String
  type          String
  status        WebhookEventStatus
  error         String?
  receivedAt    DateTime           @default(now()) @map("received_at")
  processedAt   DateTime?          @default(now()) @map("processed_at")
  lastAttemptAt DateTime?          @map("last_attempt_at")
  attemptCount  Int                @default(0) @map("attempt_count")

  @@unique([eventId, provider])
  @@index([provider, type])
  @@index([processedAt])
  @@map("webhook_event")
  @@schema("billing")
}

model Customer {
  id             String         @id @default(cuid())
  referenceId    String         @map("reference_id")
  userId         String?        @map("user_id")
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?        @map("organization_id")
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalId     String         @map("external_id")
  provider       String
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  subscriptions  Subscription[]
  orders         Order[]

  @@unique([referenceId, provider])
  @@unique([externalId, provider])
  @@unique([userId, provider], map: "customer_user_id_provider_key_v2", where: { userId: { not: null } })
  @@unique([organizationId, provider], map: "customer_organization_id_provider_key_v2", where: { organizationId: { not: null } })
  @@map("customer")
  @@schema("billing")
}

model Subscription {
  id             String             @id @default(cuid())
  customerId     String             @map("customer_id")
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalId     String             @map("external_id")
  variantId      String             @map("variant_id")
  status         SubscriptionStatus
  store          String
  periodStartsAt DateTime           @map("period_starts_at")
  periodEndsAt   DateTime           @map("period_ends_at")
  trialStartsAt  DateTime?          @map("trial_starts_at")
  trialEndsAt    DateTime?          @map("trial_ends_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([externalId, store])
  @@index([customerId, status, createdAt])
  @@map("subscription")
  @@schema("billing")
}

model Order {
  id         String        @id @default(cuid())
  customerId String        @map("customer_id")
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalId String        @map("external_id")
  variantId  String        @map("variant_id")
  status     PaymentStatus
  store      String
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([externalId, store])
  @@index([customerId, status, createdAt])
  @@map("order")
  @@schema("billing")
}
