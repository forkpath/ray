{
  "name": "ui-native",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-native/src",
  "projectType": "library",
  "tags": ["type:ui", "runtime:native", "domain:shared"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "inputs": ["production", "^production"],
      "options": {
        "cwd": "libs/ui-native",
        "command": "tsc --noEmit -p tsconfig.lib.json"
      }
    }
  }
}
