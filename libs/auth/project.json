{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.typecheck.json",
        "cwd": "libs/auth"
      }
    },
    "generate-auth-schema": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/schema-generation-frozen.mjs",
        "cwd": "libs/auth"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./src/scripts/seed.ts",
        "cwd": "libs/auth",
        "env": {
          "NODE_OPTIONS": "-r tsconfig-paths/register",
          "TS_NODE_PROJECT": "tsconfig.json"
        }
      },
      "dependsOn": [
        {
          "projects": "pg-dao",
          "target": "generate"
        }
      ]
    }
  }
}
