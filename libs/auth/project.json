{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth/src",
  "projectType": "library",
  "tags": ["type:feature", "runtime:node", "domain:auth", "boundary:facade"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.typecheck.json",
        "cwd": "libs/auth"
      }
    },
    "generate-auth-schema": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/schema-generation-frozen.mjs",
        "cwd": "libs/auth"
      }
    },
    "schema-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tools/auth-schema-tooling/package.json",
        "{workspaceRoot}/libs/pg-dao/src/models/auth.prisma"
      ],
      "options": {
        "command": "node scripts/schema-contract.mjs check",
        "cwd": "libs/auth"
      }
    },
    "schema-update": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/schema-contract.mjs update",
        "cwd": "libs/auth"
      }
    },
    "contract-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["schema-check"],
      "inputs": ["default", "^production"],
      "options": {
        "command": "node --test scripts/schema-contract.test.mjs",
        "cwd": "libs/auth"
      }
    },
    "integration-test": {
      "executor": "nx:noop",
      "cache": true,
      "dependsOn": [
        {
          "projects": "auth-server",
          "target": "integration-test"
        }
      ]
    },
    "test": {
      "executor": "nx:noop",
      "cache": true,
      "dependsOn": ["contract-test", "integration-test"]
    },
    "seed": {
      "executor": "nx:noop",
      "dependsOn": [
        {
          "projects": "auth-server",
          "target": "seed"
        }
      ]
    }
  }
}
