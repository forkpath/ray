{
  "name": "auth-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth-server/src",
  "projectType": "library",
  "tags": ["type:platform", "runtime:node", "domain:auth"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "libs/auth-server"
      }
    },
    "integration-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest --config vitest.config.mts --run",
        "cwd": "libs/auth-server"
      }
    },
    "test": {
      "executor": "nx:noop",
      "cache": true,
      "dependsOn": ["integration-test"]
    },
    "seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx ./src/scripts/seed.ts",
        "cwd": "libs/auth-server",
        "env": {
          "NODE_OPTIONS": "-r tsconfig-paths/register",
          "TS_NODE_PROJECT": "tsconfig.json"
        }
      },
      "dependsOn": [
        {
          "projects": "pg-dao",
          "target": "generate"
        }
      ]
    }
  }
}
